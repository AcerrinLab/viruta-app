# Direccion publica del backend (sin barra al final)
VITE_API_URL=http://localhost:8080
# Opcional: clave de Google Maps (Maps JavaScript API). Sin clave, las carpinterias se muestran en lista.
VITE_GOOGLE_MAPS_KEY=
# Ingreso con Google: el mismo client id que GOOGLE_CLIENT_ID del backend (vacío = sin botón)
VITE_GOOGLE_CLIENT_ID=
# Página pública de la lista de espera
VITE_WISHLIST_URL=https://viruta-wishlist.vercel.app/
