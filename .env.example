# Copiá este archivo como .env y completalo. El .env NUNCA se sube al repositorio.

# Base de datos
DB_USER=viruta
DB_PASSWORD=cambiar-esta-clave
DB_ROOT_PASSWORD=cambiar-esta-otra-clave

# Seguridad: una cadena al azar de 32 caracteres o más
JWT_SECRETO=
# Direcciones del frontend que pueden llamar a la API (separadas por coma)
CORS_ORIGENES=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Usuario administrador para ver /metricas
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Administradores maestros (panel /admin): "Nombre|email|clave;Nombre|email|clave".
# Sin clave, esa persona entra solo con Google usando ese email.
VIRUTA_ADMINS=

# Ingreso con Google: client id de Google Identity Services (console.cloud.google.com > Credenciales)
GOOGLE_CLIENT_ID=

# Wishlist: URL /exec del Apps Script de la planilla (con doGet que devuelve {clientes, talleres})
WISHLIST_SHEETS_URL=

# Negocio
COMISION_PORCENTAJE=10
SENA_PORCENTAJE=50

# Pagos: simulado (demo) o mercadopago (cobro real)
PAGOS_MODO=simulado
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRETO=

# Aviso por WhatsApp: URL del webhook de n8n (vacío = solo aviso en el panel)
N8N_WEBHOOK_URL=
